# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ============================================================================
# MULTI-PROVIDER LLM CONFIGURATION
# ============================================================================
# The agent auto-detects which provider to use based on available API keys.
# Priority order: OpenAI > Anthropic > Google > Azure > Custom endpoint
# Set ONLY ONE provider's API key (others are ignored).
# When no provider is configured, the agent runs in deterministic mode.

# --- 1. OpenAI (RECOMMENDED for GPT-4, GPT-4o, etc.)
# Uncomment and fill in your OpenAI API key:
# OPENAI_API_KEY=sk-proj-...
# (Optional) OpenAI base URL (defaults to https://api.openai.com/v1/chat/completions):
# OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
# (Optional) Model name (defaults to gpt-4o-mini):
# OPENAI_MODEL=gpt-4o-mini

# --- 2. Anthropic (Claude)
# Uncomment and fill in your Anthropic API key:
# ANTHROPIC_API_KEY=sk-ant-...
# (Optional) Model name (defaults to claude-3-5-sonnet-20241022):
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- 3. Google Gemini
# Uncomment and fill in your Google API key:
# GOOGLE_API_KEY=AIzaSy...
# (Optional) Model name (defaults to gemini-2.0-flash):
# GOOGLE_MODEL=gemini-2.0-flash

# --- 4. Azure OpenAI
# Uncomment and configure Azure credentials:
# AZURE_OPENAI_API_KEY=...
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=<deployment-name>

# --- 5. Custom OpenAI-Compatible Endpoint (Local/Self-Hosted)
# For local models via Ollama, vLLM, or other OpenAI-compatible servers:
# TRIAGE_API_KEY=local-key-or-token
# TRIAGE_LLM_URL=http://localhost:8000/v1/chat/completions
# TRIAGE_LLM_MODEL=mistral  # or any model name

# ============================================================================
# LLM BEHAVIOR TUNING
# ============================================================================
# Timeout for LLM API calls (seconds, defaults to 12):
TRIAGE_LLM_TIMEOUT_SEC=12

# ============================================================================
# RETRIEVAL TUNING (OPTIONAL)
# ============================================================================
# Confidence threshold for ticket classification (0.0-1.0, defaults to 0.07):
RETRIEVAL_CONFIDENCE_THRESHOLD=0.07
# Number of top-K documents to retrieve (defaults to 3):
RETRIEVAL_TOP_K=3
